        "dropout": 0.1
      }
    },
    "dual_stream_film": {
      "label": "DualStream-FiLM",
      "builder": "dual_stream_film",
      "batch_size": 128,
      "epochs": 50,
      "learning_rate": 0.0007,
      "loss": "huber",
      "shuffle": true,
      "feature_groups": {
        "endogenous": [
          "act_pow_pu",
          "react_pow_pu",
          "pfactor",
          "dP",
          "moving_avg_5",
          "moving_avg_10",
          "moving_avg_20",
          "moving_std_5",
          "moving_std_10",
          "moving_std_20"
        ],
        "propulsion": [
          "lever_diff",
          "spd_port",
          "spd_stbd"
        ],
        "environment": [
          "air_temp",
          "sea_temp",
          "wind_intensity",
          "sea_state"
        ]
      },
      "builder_args": {
        "dynamics_width": 48,
        "command_hidden": 16,
        "environment_hidden": 8,
        "context_width": 24,
        "kernel_size": 3,
        "dropout_rate": 0.1,
        "film_scale": 0.5,
        "head_mode": "flat_direct",
        "horizon_embed_dim": 16,
        "decoder_width": 64
      }
    }
